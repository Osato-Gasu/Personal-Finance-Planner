{
  "name": "personal-finance-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build:app": "vite build",
    "build": "npm run build:app && node tools/sync-root-launcher.mjs",
    "verify:launcher": "npm run build:app && node tools/sync-root-launcher.mjs --check",
    "test:completion": "pwsh -NoProfile -ExecutionPolicy Bypass -File tools/test-complete-task-local.ps1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rules": "vitest run tests/take-home-rules.test.ts",
    "test:nisa": "vitest run tests/nisa-rules.test.ts tests/nisa-state.test.ts",
    "test:ideco": "vitest run tests/ideco-rules.test.ts tests/ideco-state.test.ts",
    "test:overview": "vitest run tests/overview.test.ts",
    "test:distribution:contract": "vitest run tests/product-metadata.test.ts tests/distribution.test.mjs tests/distribution-workflow.test.mjs",
    "test:public-exposure-audit": "vitest run tests/public-exposure-audit.test.mjs",
    "audit:public": "node tools/public-exposure-audit.mjs",
    "test:distribution": "npm run build && node tools/test-distribution-browser.mjs",
    "test:portable": "npm run build && node tools/test-portable-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests tools/*.mjs vite.config.ts",
    "format:check": "prettier --check index.html src tests tools/*.mjs package.json package-lock.json tsconfig.json vite.config.ts eslint.config.js .github/workflows/*.yml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "playwright-core": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  }
}
